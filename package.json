{
  "name": "telecharger-pro",
  "version": "1.0.0",
  "description": "Téléchargeur façon IDM : interface légère, téléchargement multi-blocs et reprise après coupure réseau, redémarrage ou même des mois plus tard.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "start:gui": "electron .",
    "backend": "node scripts/start.js --no-gui",
    "setup": "node scripts/install.js",
    "dist": "node scripts/build.js",
    "build": "node scripts/build.js",
    "release": "node scripts/build.js --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oumarmouhammad92-commits/telecharger-pro.git"
  },
  "author": {
    "name": "oumarmouhammad92",
    "email": "oumarmouhammad92@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oumarmouhammad92-commits/telecharger-pro/issues"
  },
  "homepage": "https://github.com/oumarmouhammad92-commits/telecharger-pro",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.oumarmouhammad92.telechargerpro",
    "productName": "Telechargeur Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": ["**/*.py"]
      },
      {
        "from": "python-embed",
        "to": "python-embed"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": ["icon.ico", "icon.png"]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telechargeur Pro",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "uninstallDisplayName": "Telechargeur Pro",
      "artifactName": "Telechargeur-Pro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Telechargeur-Pro-Portable-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "oumarmouhammad92-commits",
      "repo": "telecharger-pro"
    }
  }
}
